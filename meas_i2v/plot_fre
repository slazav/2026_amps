#!/usr/bin/gnuplot

set terminal png size 800,600

#set log y
set xlabel "Vin, V"
set ylabel "Vout/Vin"
set key bottom left
set grid mxtics mytics xtics ytics
set log

R1=10e3
R2=100e3
R3=1e6

set output "plot_fre1.png"

plot [1000:4e6] [1:3000]\
  "A1S1_fre.dat" u 1:($4/$8*R1/1e3) w lp pt 7 title "22k",\
  "A1S2_fre.dat" u 1:($4/$8*R1/1e3) w lp pt 7 title "51k",\
  "A1S3_fre.dat" u 1:($4/$8*R2/1e3) w lp pt 7 title "100k",\
  "A1S4_fre.dat" u 1:($4/$8*R2/1e3) w lp pt 7 title "220k",\
  "A1S5_fre.dat" u 1:($4/$8*R2/1e3) w lp pt 7 title "510k",\
  "A1S6_fre.dat" u 1:($4/$8*R3/1e3) w lp pt 7 title "1M",\
  22 lc 7 notitle,\
  51 lc 7 notitle,\
  100 lc 7 notitle,\
  220 lc 7 notitle,\
  510 lc 7 notitle,\
  1000 lc 7 notitle

set output "plot_fre2.png"

plot [1000:4e6] [1:3000]\
  "A2S1_fre.dat" u 1:($4/$8*R1/1e3) w lp pt 7 title "22k",\
  "A2S2_fre.dat" u 1:($4/$8*R1/1e3) w lp pt 7 title "51k",\
  "A2S3_fre.dat" u 1:($4/$8*R2/1e3) w lp pt 7 title "100k",\
  "A2S4_fre.dat" u 1:($4/$8*R2/1e3) w lp pt 7 title "220k",\
  "A2S5_fre.dat" u 1:($4/$8*R2/1e3) w lp pt 7 title "510k",\
  "A2S6_fre.dat" u 1:($4/$8*R3/1e3) w lp pt 7 title "1M",\
  22 lc 7 notitle,\
  51 lc 7 notitle,\
  100 lc 7 notitle,\
  220 lc 7 notitle,\
  510 lc 7 notitle,\
  1000 lc 7 notitle
