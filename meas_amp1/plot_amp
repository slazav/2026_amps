print "A2S2: ", A
fit [:0.7] f(x) "A2S3_amp.dat" u 8:($4/$8) via A
print "A2S3: ", A
fit [:0.2] f(x) "A2S4_amp.dat" u 8:($4/$8) via A
print "A2S4: ", A
fit [:0.07] f(x) "A2S5_amp.dat" u 8:($4/$8) via A
print "A2S5: ", A
fit [:0.02] f(x) "A2S6_amp.dat" u 8:($4/$8) via A
print "A2S6: ", A

plot [0.001:30] [:1000]\
  "A2S1_amp.dat" u 8:($4/$8) w lp pt 7 title "S1",\
  "A2S2_amp.dat" u 8:($4/$8) w lp pt 7 title "S2",\
  "A2S3_amp.dat" u 8:($4/$8) w lp pt 7 title "S3",\
