#!/usr/bin/gnuplot

set terminal png size 800,600

#set log y
set xlabel "f, Hz"
set ylabel "Iout/Vin [1/Ohm]"
set key bottom left
set grid mxtics mytics xtics ytics
set log

set output "plot_C1R1e2_fre.png"
set title "Ch:1, K:1e-2"

plot [800:] []\
  "C1_R1e2_L1e2_fre.dat" u 1:($4/$8/1e2) w lp pt 7 title "Load: 100",\
  "C1_R1e2_L1e3_fre.dat" u 1:($4/$8/1e3) w lp pt 7 title "Load: 1k",\
  "C1_R1e2_L1e4_fre.dat" u 1:($4/$8/1e4) w lp pt 7 title "Load: 10k",\
  "C1_R1e2_L1e5_fre.dat" u 1:($4/$8/1e5) w lp pt 7 title "Load: 100k",\


